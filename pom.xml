<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.7.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>cc.abing</groupId>
	<artifactId>abstart-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>ABStart</name>
	<description>A Simple Spring Boot Project</description>
	<packaging>pom</packaging>

	<modules>
		<module>api</module>
		<module>biz</module>
		<module>dao</module>
		<module>model</module>
		<module>util</module>
		<module>dao</module>
		<module>support</module>
	</modules>

	<dependencyManagement>
		<dependencies>
			<!--子模块-START-->
			<dependency>
				<groupId>cc.abing</groupId>
				<artifactId>abstart-api</artifactId>
				<version>0.0.1-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>cc.abing</groupId>
				<artifactId>abstart-biz</artifactId>
				<version>0.0.1-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>cc.abing</groupId>
				<artifactId>abstart-dao</artifactId>
				<version>0.0.1-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>cc.abing</groupId>
				<artifactId>abstart-model</artifactId>
				<version>0.0.1-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>cc.abing</groupId>
				<artifactId>abstart-support</artifactId>
				<version>0.0.1-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>cc.abing</groupId>
				<artifactId>abstart-util</artifactId>
				<version>0.0.1-SNAPSHOT</version>
			</dependency>
			<!--子模块-END-->

			<!--全局排除logback,使用log4j2日志框架-->
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-starter-logging</artifactId>
				<exclusions>
					<exclusion>
						<groupId>*</groupId>
						<artifactId>*</artifactId>
					</exclusion>
				</exclusions>
			</dependency>
		</dependencies>
	</dependencyManagement>


	<dependencies>
		<!--Spring依赖-START-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-log4j2</artifactId>
		</dependency>
		<!--Spring依赖-END-->
	</dependencies>

</project>
